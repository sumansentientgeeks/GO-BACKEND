# Application
PORT=8080
ENV=development

# WebRTC Free TURN Relay Server (for Production NAT & Firewall Traversal)
TURN_SERVER_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp,turns:openrelay.metered.ca:443?transport=tcp
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hello?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# LiveKit (if using LiveKit room fallback)
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
LIVEKIT_URL=wss://your-livekit-server.url
