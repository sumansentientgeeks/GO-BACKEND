# RabbitMQ server container with management plugin enabled
FROM rabbitmq:3-management-alpine

# Set default credentials
ENV RABBITMQ_DEFAULT_USER=guest
ENV RABBITMQ_DEFAULT_PASS=guest
ENV RABBITMQ_DEFAULT_VHOST=/

# Expose AMQP standard port and Management Dashboard port
EXPOSE 5672 15672

# Health check to ensure RabbitMQ broker is accepting TCP connections
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD rabbitmq-diagnostics -q ping || exit 1

# Start RabbitMQ server
CMD ["rabbitmq-server"]
