# Application
PORT=8080
ENV=development

# WebRTC SFU Cloud & NAT Configuration (for Production VMs / Docker / AWS / VPS)
# Set your public IP or cloud load balancer IP for NAT 1:1 traversal
# NAT_1TO1_IP=your.public.server.ip
# UDP_PORT_MIN=50000
# UDP_PORT_MAX=50100

# Custom TURN Relay Server (optional, defaults to fallback OpenRelay)
# TURN_SERVER_URL=turn:your-turn-server.com:3478,turn:your-turn-server.com:3478?transport=tcp
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_password

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hello?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# LiveKit (if using LiveKit room fallback)
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
LIVEKIT_URL=wss://your-livekit-server.url
